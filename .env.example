# =============================================================================
# CHAKRA Multi-Vendor Marketplace - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# CLIENT-SIDE VARIABLES (Exposed to the browser with NEXT_PUBLIC_ prefix)
# -----------------------------------------------------------------------------

# Supabase Public API endpoint & anonymous public key
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Razorpay Key ID (Public key for opening payment checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Base Application URL (for canonical SEO and referral link resolution)
NEXT_PUBLIC_APP_URL="https://chakra-marketplace.in"

# -----------------------------------------------------------------------------
# SERVER-SIDE PRIVATE SECRETS (NEVER EXPOSE TO THE CLIENT OR BROWSER)
# -----------------------------------------------------------------------------

# Supabase Service Role Key: Used strictly inside serverless functions & API routes
# for administrative database operations and signing private storage URLs.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Razorpay API Credentials (Stored in Netlify Environment Variables)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# Razorpay Webhook Secret (Configured in Razorpay Dashboard for HMAC-SHA256 verification)
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# Razorpay Route Marketplace Split (Set to true only after contractual Route activation)
RAZORPAY_ROUTE_ENABLED="false"

# Live mode flag (Set to true for live production payments; never simulates live payments)
RAZORPAY_LIVE_MODE="false"

# Optional Gemini AI API Key (Injected by runtime for server-side AI features)
GEMINI_API_KEY="your-gemini-api-key"
